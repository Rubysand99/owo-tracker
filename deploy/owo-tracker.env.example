# /etc/owo-tracker.env — cấu hình owo-tracker trên VPS.
# File này chứa BÍ MẬT: chỉ root đọc được (chmod 600), đừng commit hay gửi cho ai.
# Định dạng: KEY=giá trị — không có dấu cách quanh dấu =, không bọc dấu nháy,
# và KHÔNG viết chú thích cùng dòng với giá trị (chú thích phải nằm ở dòng riêng như dòng này).

# Token của BOT (Discord Developer Portal -> Bot -> Reset Token). Giữ nguyên giá trị đang dùng ở Railway.
DISCORD_TOKEN=CHANGE_ME

# ID Discord của bạn (chủ bot).
OWNER_ID=CHANGE_ME

# Chuỗi kết nối MongoDB, ví dụ mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/
# Dùng lại đúng chuỗi đang chạy ở Railway thì KHÔNG phải chuyển dữ liệu.
MONGODB_URI=CHANGE_ME

# Tên database. Giữ nguyên tên đang dùng ở Railway (mặc định owo_tracker).
MONGODB_DB_NAME=owo_tracker

# Token để app AutoMacro gọi API (nhập y hệt vào Cài đặt của app). setup-vps.sh đã tự sinh sẵn một chuỗi ngẫu nhiên.
AUTOMACRO_API_TOKEN=@API_TOKEN@

# API chỉ lắng nghe trong máy (127.0.0.1) để Caddy lo HTTPS bên ngoài. Không dùng Caddy/nginx thì đổi thành 0.0.0.0.
AUTOMACRO_API_HOST=@API_HOST@
AUTOMACRO_API_PORT=@API_PORT@
